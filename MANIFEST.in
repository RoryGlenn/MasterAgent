include AGENTS.md CHANGELOG.md README.md .env.example LICENSE
include THIRD_PARTY_NOTICES.md requirements-runtime.lock sbom.cdx.json
recursive-include .ai *.md
recursive-include .github/agents *.md
include .github/workflows/ci.yml .github/workflows/confluence-sandbox.yml
recursive-include config *.toml
recursive-include docs *.md
recursive-include examples *
recursive-include scripts *.py
recursive-include specs *
recursive-include supply-chain *.toml
recursive-include tests *.py
global-exclude .DS_Store *.py[cod]
prune .master-agent
