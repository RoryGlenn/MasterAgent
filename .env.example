# Variable names consumed by the disabled example connector profiles.
# Keep values empty in source control. Inject real credentials at runtime from
# an approved secret manager; do not copy a populated file into this repository.

MASTER_AGENT_JIRA_USERNAME=
MASTER_AGENT_JIRA_TOKEN=
MASTER_AGENT_CONFLUENCE_USERNAME=
MASTER_AGENT_CONFLUENCE_TOKEN=
# Atlassian REST API tokens use the account email. Private legacy app-password
# configurations may continue to declare MASTER_AGENT_BITBUCKET_USERNAME.
MASTER_AGENT_BITBUCKET_EMAIL=
MASTER_AGENT_BITBUCKET_TOKEN=
MASTER_AGENT_GITHUB_TOKEN=
MASTER_AGENT_ENTERPRISE_CA_BUNDLE=
MASTER_AGENT_REPOSITORY_ROOT=

MASTER_AGENT_ENTRA_TENANT_ID=
MASTER_AGENT_ENTRA_PUBLIC_CLIENT_ID=
MASTER_AGENT_ENTRA_APP_CLIENT_ID=
MASTER_AGENT_ENTRA_APP_CLIENT_SECRET=
MASTER_AGENT_GRAPH_TOKEN_FILE=
MASTER_AGENT_GRAPH_ACCESS_TOKEN=
MASTER_AGENT_GRAPH_ACCESS_TOKEN_EXPIRES_AT=
